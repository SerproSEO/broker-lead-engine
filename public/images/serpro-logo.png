<svg width="200" height="60" viewBox="0 0 200 60" xmlns="http://www.w3.org/2000/svg">
  <!-- Clean professional logo design -->
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#16a571;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#138a5e;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Icon - stylized S -->
  <g transform="translate(10, 10)">
    <rect width="40" height="40" rx="8" fill="url(#gradient)"/>
    <path d="M15 18 Q15 12, 25 12 Q35 12, 35 18 Q35 24, 25 24 Q15 24, 15 30 Q15 36, 25 36 Q35 36, 35 30" 
          stroke="white" stroke-width="3" fill="none" stroke-linecap="round"/>
  </g>
  
  <!-- Text -->
  <text x="60" y="30" font-family="'Segoe UI', Arial, sans-serif" font-size="24" font-weight="700" fill="#1a202c">Serpro</text>
  <text x="60" y="48" font-family="'Segoe UI', Arial, sans-serif" font-size="14" font-weight="500" fill="#16a571">SEO MARKETING</text>
</svg>