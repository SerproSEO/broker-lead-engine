{% comment %}
Blog Article Template for Professional Liability Insurance Marketing
Version: 1.0
Compatible with: Shopify Online Store 2.0
{% endcomment %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary SEO -->
    <title>{{ article.title }}{% if current_page != 1 %} - Page {{ current_page }}{% endif %} | {{ shop.name }}</title>
    <meta name="description" content="{{ article.excerpt | default: article.content | strip_html | truncate: 155 }}">
    <meta name="keywords" content="{{ article.tags | join: ', ' }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ shop.url }}{{ article.url }}">
    <meta property="og:title" content="{{ article.title }}">
    <meta property="og:description" content="{{ article.excerpt | default: article.content | strip_html | truncate: 155 }}">
    {% if article.image %}
        <meta property="og:image" content="{{ article.image | img_url: '1200x630' }}">
    {% else %}
        <meta property="og:image" content="{{ 'og-default-blog.jpg' | asset_url }}">
    {% endif %}
    <meta property="article:author" content="{{ article.author }}">
    <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%d' }}">
    <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%d' }}">
    {% for tag in article.tags %}
        <meta property="article:tag" content="{{ tag }}">
    {% endfor %}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="{{ shop.url }}{{ article.url }}">
    <meta property="twitter:title" content="{{ article.title }}">
    <meta property="twitter:description" content="{{ article.excerpt | default: article.content | strip_html | truncate: 155 }}">
    {% if article.image %}
        <meta property="twitter:image" content="{{ article.image | img_url: '1200x630' }}">
    {% else %}
        <meta property="twitter:image" content="{{ 'og-default-blog.jpg' | asset_url }}">
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ shop.url }}{{ article.url }}">

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="author" content="{{ article.author }}">
    <meta name="geo.region" content="US">
    <meta name="geo.placename" content="New York">

    <!-- Preload critical resources -->
    <link rel="preload" href="{{ 'styles.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'script.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'logo.png' | asset_url }}" as="image">

    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">

    <!-- Blog-specific styles -->
    <style>
        .blog-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .blog-header {
            margin-top: 120px;
            padding: 3rem 0;
        }

        .blog-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            color: var(--gray);
            font-size: 0.9rem;
        }

        .blog-category {
            background: var(--accent-gradient);
            color: var(--white);
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            text-decoration: none;
        }

        .blog-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.1;
            color: var(--dark);
            margin-bottom: 1rem;
        }

        .blog-excerpt {
            font-size: 1.2rem;
            color: var(--gray);
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .featured-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 16px;
            margin-bottom: 3rem;
        }

        .blog-content-wrapper {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 4rem;
            margin-bottom: 4rem;
        }

        .blog-content {
            line-height: 1.8;
            font-size: 1.1rem;
        }

        .blog-content h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2rem;
            font-weight: 600;
            color: var(--dark);
            margin: 3rem 0 1rem 0;
            scroll-margin-top: 120px;
        }

        .blog-content h3 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--dark);
            margin: 2rem 0 1rem 0;
            scroll-margin-top: 120px;
        }

        .blog-content p {
            margin-bottom: 1.5rem;
        }

        .blog-content ul, .blog-content ol {
            margin-bottom: 1.5rem;
            padding-left: 2rem;
        }

        .blog-content li {
            margin-bottom: 0.5rem;
        }

        .blog-sidebar {
            position: sticky;
            top: 140px;
            height: fit-content;
        }

        .table-of-contents {
            background: var(--light-gray);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .toc-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--dark);
        }

        .toc-list {
            list-style: none;
            padding: 0;
        }

        .toc-list li {
            margin-bottom: 0.5rem;
        }

        .toc-list a {
            color: var(--gray);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

        .toc-list a:hover {
            color: var(--primary);
        }

        .author-bio {
            background: var(--white);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .author-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            margin-bottom: 1rem;
        }

        .author-name {
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }

        .author-title {
            font-size: 0.9rem;
            color: var(--gray);
            margin-bottom: 1rem;
        }

        .author-description {
            font-size: 0.9rem;
            line-height: 1.5;
            color: var(--gray);
        }

        .social-share {
            background: var(--light-gray);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .share-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--dark);
        }

        .share-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .share-button {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            text-decoration: none;
            transition: transform 0.3s ease;
        }

        .share-button:hover {
            transform: translateY(-2px);
        }

        .share-linkedin { background: #0077b5; }
        .share-twitter { background: #1da1f2; }
        .share-facebook { background: #1877f2; }

        .related-posts {
            margin: 4rem 0;
        }

        .related-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 2rem;
            color: var(--dark);
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .related-card {
            background: var(--white);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            text-decoration: none;
            color: inherit;
        }

        .related-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        .related-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .related-content {
            padding: 1.5rem;
        }

        .related-card-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--dark);
        }

        .related-excerpt {
            color: var(--gray);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .blog-cta {
            background: var(--gradient);
            color: var(--white);
            padding: 3rem;
            border-radius: 16px;
            text-align: center;
            margin: 4rem 0;
        }

        .cta-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .cta-description {
            font-size: 1.1rem;
            margin-bottom: 2rem;
            opacity: 0.9;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            background: var(--white);
            color: var(--primary);
            padding: 1rem 2rem;
            border-radius: 100px;
            text-decoration: none;
            font-weight: 600;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(255, 255, 255, 0.3);
        }

        @media (max-width: 768px) {
            .blog-content-wrapper {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .blog-sidebar {
                position: static;
                order: -1;
            }

            .blog-title {
                font-size: 2rem;
            }

            .table-of-contents {
                display: none;
            }
        }
    </style>

    <!-- Schema.org structured data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "{{ article.title }}",
        "description": "{{ article.excerpt | default: article.content | strip_html | truncate: 155 }}",
        "image": {% if article.image %}"{{ article.image | img_url: '1200x630' }}"{% else %}"{{ 'og-default-blog.jpg' | asset_url }}"{% endif %},
        "author": {
            "@type": "Person",
            "name": "{{ article.author }}",
            "url": "{{ shop.url }}/blogs/{{ blog.handle }}/authors/{{ article.author | handleize }}"
        },
        "publisher": {
            "@type": "Organization",
            "name": "{{ shop.name }}",
            "logo": {
                "@type": "ImageObject",
                "url": "{{ 'logo.png' | asset_url }}"
            }
        },
        "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
        "dateModified": "{{ article.updated_at | date: '%Y-%m-%d' }}",
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ shop.url }}{{ article.url }}"
        },
        "keywords": "{{ article.tags | join: ', ' }}",
        "articleSection": "{{ blog.title }}",
        "wordCount": {{ article.content | strip_html | split: ' ' | size }},
        "about": {
            "@type": "Thing",
            "name": "Professional Liability Insurance"
        },
        "mentions": [
            {
                "@type": "Service",
                "name": "Professional Liability Insurance SEO",
                "provider": {
                    "@type": "Organization",
                    "name": "{{ shop.name }}"
                }
            }
        ]
    }
    </script>
</head>

<body>
    <!-- Header (Fixed at top) - Exact copy from homepage -->
    <header class="header">
        <div class="header-content">
            <a href="{{ routes.root_url }}" class="logo">
                <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}">
            </a>

            <!-- Simple Mobile Menu Button -->
            <button class="menu-toggle" onclick="toggleMenu()">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="nav" id="navigation">
                <a href="{{ routes.root_url }}" class="nav-link">Home</a>
                <div class="nav-dropdown">
                    <a href="/pages/professional-liability-seo" class="nav-link">Services</a>
                    <div class="dropdown-menu">
                        <a href="/pages/professional-liability-seo" class="dropdown-link">Professional Liability SEO</a>
                        <a href="/pages/new-york-professional-liability-seo" class="dropdown-link">New York SEO</a>
                        <a href="/pages/legal-malpractice-insurance-seo" class="dropdown-link">Legal Malpractice SEO</a>
                    </div>
                </div>
                <a href="/pages/about" class="nav-link">About</a>
                <a href="/pages/contact" class="nav-link">Contact</a>
                <a href="#demo" class="cta-button">Get Started</a>
            </nav>
        </div>
    </header>

    <!-- Blog Article Content -->
    <main class="blog-container">
        <!-- Blog Header -->
        <header class="blog-header">
            <div class="blog-meta">
                {% if blog %}
                    <a href="{{ blog.url }}" class="blog-category">{{ blog.title }}</a>
                {% endif %}
                <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
                <span>•</span>
                <span>{{ article.author }}</span>
                <span>•</span>
                <span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 }} min read</span>
            </div>

            <h1 class="blog-title">{{ article.title }}</h1>

            {% if article.excerpt %}
                <div class="blog-excerpt">{{ article.excerpt }}</div>
            {% endif %}

            {% if article.image %}
                <img src="{{ article.image | img_url: '1200x600' }}" alt="{{ article.image.alt | default: article.title }}" class="featured-image">
            {% endif %}
        </header>

        <!-- Blog Content Grid -->
        <div class="blog-content-wrapper">
            <!-- Main Content -->
            <article class="blog-content">
                {{ article.content }}
            </article>

            <!-- Sidebar -->
            <aside class="blog-sidebar">
                {% if settings.show_table_of_contents %}
                    <div class="table-of-contents">
                        <h3 class="toc-title">Table of Contents</h3>
                        <ul class="toc-list" id="toc-list">
                            <!-- Auto-generated by JavaScript -->
                        </ul>
                    </div>
                {% endif %}

                {% if settings.show_author_bio %}
                    <div class="author-bio">
                        {% if settings.author_avatar %}
                            <img src="{{ settings.author_avatar | img_url: '120x120' }}" alt="{{ article.author }}" class="author-avatar">
                        {% endif %}
                        <div class="author-name">{{ article.author }}</div>
                        <div class="author-title">{{ settings.author_title | default: 'Professional Liability Insurance Expert' }}</div>
                        <div class="author-description">
                            {{ settings.author_bio | default: 'Specialized in professional liability insurance marketing and SEO strategies for insurance agencies.' }}
                        </div>
                    </div>
                {% endif %}

                {% if settings.show_social_share %}
                    <div class="social-share">
                        <h3 class="share-title">Share This Article</h3>
                        <div class="share-buttons">
                            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ article.url }}" target="_blank" class="share-button share-linkedin">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                            </a>
                            <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}" target="_blank" class="share-button share-twitter">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                </svg>
                            </a>
                            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" class="share-button share-facebook">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                {% endif %}
            </aside>
        </div>

        <!-- CTA Section -->
        {% if settings.show_blog_cta %}
            <section class="blog-cta">
                <h2 class="cta-title">{{ settings.blog_cta_title | default: 'Ready to Dominate Professional Liability Insurance SEO?' }}</h2>
                <p class="cta-description">{{ settings.blog_cta_description | default: 'Get your free SEO analysis and discover how to capture more professional liability insurance leads.' }}</p>
                <a href="{{ settings.blog_cta_link | default: '/pages/contact' }}" class="cta-button">
                    {{ settings.blog_cta_button_text | default: 'Get Free SEO Analysis' }}
                </a>
            </section>
        {% endif %}

        <!-- Related Posts -->
        {% if settings.show_related_posts %}
            <section class="related-posts">
                <h2 class="related-title">Related Articles</h2>
                <div class="related-grid">
                    {% assign related_posts = blog.articles | where: 'id', '!=', article.id %}
                    {% assign matching_posts = '' %}

                    {% comment %} Find posts with matching tags {% endcomment %}
                    {% for related_article in related_posts %}
                        {% for tag in article.tags %}
                            {% if related_article.tags contains tag %}
                                {% assign matching_posts = matching_posts | append: related_article.id | append: ',' %}
                                {% break %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}

                    {% assign matching_post_ids = matching_posts | split: ',' %}
                    {% assign displayed_count = 0 %}

                    {% for post_id in matching_post_ids limit: 3 %}
                        {% if displayed_count < 3 %}
                            {% assign related_article = related_posts | where: 'id', post_id | first %}
                            {% if related_article %}
                                <a href="{{ related_article.url }}" class="related-card">
                                    {% if related_article.image %}
                                        <img src="{{ related_article.image | img_url: '400x200' }}" alt="{{ related_article.title }}" class="related-image">
                                    {% endif %}
                                    <div class="related-content">
                                        <h3 class="related-card-title">{{ related_article.title }}</h3>
                                        <p class="related-excerpt">{{ related_article.excerpt | default: related_article.content | strip_html | truncate: 120 }}</p>
                                    </div>
                                </a>
                                {% assign displayed_count = displayed_count | plus: 1 %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}

                    {% comment %} Fill remaining slots with recent posts if needed {% endcomment %}
                    {% if displayed_count < 3 %}
                        {% for related_article in related_posts limit: 3 %}
                            {% unless matching_post_ids contains related_article.id %}
                                {% if displayed_count < 3 %}
                                    <a href="{{ related_article.url }}" class="related-card">
                                        {% if related_article.image %}
                                            <img src="{{ related_article.image | img_url: '400x200' }}" alt="{{ related_article.title }}" class="related-image">
                                        {% endif %}
                                        <div class="related-content">
                                            <h3 class="related-card-title">{{ related_article.title }}</h3>
                                            <p class="related-excerpt">{{ related_article.excerpt | default: related_article.content | strip_html | truncate: 120 }}</p>
                                        </div>
                                    </a>
                                    {% assign displayed_count = displayed_count | plus: 1 %}
                                {% endif %}
                            {% endunless %}
                        {% endfor %}
                    {% endif %}
                </div>
            </section>
        {% endif %}
    </main>

    <!-- Footer - Exact copy from homepage -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="/pages/privacy-policy" class="footer-link">Privacy Policy</a>
                <a href="/pages/terms-of-service" class="footer-link">Terms of Service</a>
                <a href="/pages/contact" class="footer-link">Contact</a>
            </div>

            <div class="footer-disclaimer">
                <p class="disclaimer-text">
                    <strong>DISCLAIMER:</strong> Results not guaranteed. Past performance does not guarantee future results. SEO rankings depend on numerous factors including competition, algorithm changes, and market conditions. Individual results may vary. {{ shop.name }} provides marketing services only and does not provide legal, insurance, or financial advice. All information is provided for educational purposes only.
                </p>
            </div>

            <p class="footer-text">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
        </div>
    </footer>

    <!-- Table of Contents Generation -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Generate Table of Contents
            const content = document.querySelector('.blog-content');
            const tocList = document.getElementById('toc-list');

            if (content && tocList) {
                const headings = content.querySelectorAll('h2, h3');

                headings.forEach(function(heading, index) {
                    // Create anchor ID
                    const anchorId = 'heading-' + index;
                    heading.id = anchorId;

                    // Create TOC entry
                    const listItem = document.createElement('li');
                    const link = document.createElement('a');
                    link.href = '#' + anchorId;
                    link.textContent = heading.textContent;

                    // Add indentation for h3
                    if (heading.tagName === 'H3') {
                        link.style.paddingLeft = '1rem';
                    }

                    listItem.appendChild(link);
                    tocList.appendChild(listItem);
                });
            }

            // Smooth scroll for TOC links
            document.querySelectorAll('.toc-list a').forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        const headerHeight = document.querySelector('.header').offsetHeight;
                        const targetPosition = target.offsetTop - headerHeight - 20;

                        window.scrollTo({
                            top: targetPosition,
                            behavior: 'smooth'
                        });
                    }
                });
            });
        });

        // Mobile menu toggle function
        function toggleMenu() {
            const nav = document.getElementById('navigation');
            const menuToggle = document.querySelector('.menu-toggle');

            nav.classList.toggle('active');
            menuToggle.classList.toggle('active');
        }
    </script>

    <script src="{{ 'script.js' | asset_url }}"></script>
</body>
</html>